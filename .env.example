# =============================================
# 环境变量模板（可提交到 Git）
# 使用方法：复制本文件为 .env，再填入真实值
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 注意：.env 含密钥，禁止提交
# =============================================

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=你的apikey

# DeepSeek 模型选择（可选，默认 deepseek-v4-flash）
# deepseek-v4-flash → 通用对话，速度快、成本低，日常任务首选
# deepseek-v4-pro   → 复杂推理与 Agent 任务，能力更强
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily 搜索 API Key（可选，demo-search 和 demo-multi 需要）
# 获取地址：https://app.tavily.com/
TAVILY_API_KEY=

# 温度参数（可选，默认 0.7）
# 0   = 完全精确，几乎无随机性（代码生成推荐）
# 0.7 = 均衡，日常任务推荐
# 1.0 = 高度发散，内容创作推荐
DEEPSEEK_TEMPERATURE=0.7

# 模型上下文消息条数上限（可选，默认 20）
DEEPSEEK_MAX_HISTORY=20

# Web UI 端口（可选，默认 5173）
PORT=5173

# 监听地址（容器/公网部署用 0.0.0.0；本机默认即可）
HOST=0.0.0.0

# ---------- 在线部署（给别人用时必填） ----------
# 访问口令：开启后打开网页需先输入，再访问所有 /api/*
# 请使用足够长的随机字符串，不要用简单密码
ACCESS_TOKEN=

# 多用户访问口令（可选）：JSON 中每个用户使用不同口令，用户 ID 仅允许字母、数字、_、-
# 配置后会话和输出目录按用户隔离；ACCESS_TOKEN 仍作为 owner 管理账号保留
# ACCESS_TOKENS={"alice":"请替换成长随机口令A","bob":"请替换成长随机口令B"}
ACCESS_TOKENS=

# 公网模式：true 时强制要求 ACCESS_TOKEN，并锁定输出目录（禁止任意本机路径）
PUBLIC_MODE=false

# 每个 IP 每分钟对话次数上限（防刷 API）
RATE_LIMIT_PER_MIN=30

# Agent 单轮请求总超时，超时或浏览器断开时取消模型及工具调用
AGENT_REQUEST_TIMEOUT_MS=120000

# Agent 最大并发数（默认 5），Web UI 同时处理的对话数上限
AGENT_MAX_CONCURRENT=5

# 单工具默认超时和每轮最多自动匹配工具数
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_MAX_TOOLS_PER_TURN=3

# ---------- 图片 OCR（输入框单图识别） ----------
# 默认同时识别简体中文和英文；语言数据随 npm 依赖安装，不依赖运行时外网下载。
OCR_LANGUAGES=eng+chi_sim

# 可选：自定义语言数据目录；留空时使用项目内置的中英文数据。
OCR_LANG_PATH=

# 防止超高分辨率图片耗尽内存，以及限制进入模型上下文的 OCR 文字长度。
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_TEXT_CHARS=20000

# ---------- 工作区知识库 / RAG（可选） ----------
# 开启后，Agent 可通过“根据工作区资料……”等明确指令检索当前工作区。
RAG_ENABLED=false

# Embedding 使用独立的 OpenAI-compatible 接口，不要填写 DeepSeek API Key。
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small

# 可选：部分 embedding 模型支持指定向量维度；留空使用服务默认值。
RAG_EMBEDDING_DIMENSIONS=

# 检索与索引参数。修改模型、分块参数或文件清单后会自动重建索引。
RAG_TOP_K=5
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_MAX_FILE_BYTES=2097152
RAG_MAX_TOTAL_BYTES=52428800
RAG_MAX_FILES=2000
RAG_REFRESH_INTERVAL_MS=30000

# 可选：评测时让 DeepSeek 生成答案，并评分相关性、忠实度和引用质量。
# 默认 false 时只计算稳定、无额外模型费用的 Hit Rate/MRR/Precision/Recall。
RAG_EVAL_LLM_ENABLED=false
RAG_EVAL_MODEL=

# ---------- 可观测性（均为可选） ----------
# Pino 日志等级：trace/debug/info/warn/error/fatal；生产建议 info
LOG_LEVEL=info

# 部署版本，会随结构化日志和 Sentry 事件上报，便于定位问题版本
APP_VERSION=

# 配置后才启用 Sentry；留空时不会向任何外部服务发送数据
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Sentry 性能追踪采样率，0 表示关闭；生产可从 0.05 开始
SENTRY_TRACES_SAMPLE_RATE=0
