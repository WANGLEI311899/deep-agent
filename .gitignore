# 环境变量（包含 API Key，绝对不能提交）
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# 保留可公开的模板
!.env.example

# 本地工作区 / 会话（含用户路径与对话内容）
.deepcodex/workspaces.json
.deepcodex/sessions.json
# RAG 向量缓存和评测报告可由源文档重建，不提交仓库。
.deepcodex/rag/
.deepcodex/rag-evaluations/
.deepcodex/rag-eval.json
# OCR 语言数据可从 npm 依赖恢复，运行时会自动生成本地缓存。
.deepcodex/ocr-langs/

# 依赖目录（体积大，从 package.json 恢复）
node_modules/
.certs/

# 编译产物（可以重新构建）
dist/

# AI 生成的输出文件（每个人本地不同）
output/*
!output/.gitkeep

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log
npm-debug.log*
.deepcodex-ui*.log

# Keep only the Lucide icons referenced by the task-canvas UI.
web/public/vendor/lucide/
web/public/vendor/lucide-icons/*
!web/public/vendor/lucide-icons/arrow-right.svg
!web/public/vendor/lucide-icons/blocks.svg
!web/public/vendor/lucide-icons/bot.svg
!web/public/vendor/lucide-icons/check.svg
!web/public/vendor/lucide-icons/chevron-left.svg
!web/public/vendor/lucide-icons/ellipsis.svg
!web/public/vendor/lucide-icons/file-text.svg
!web/public/vendor/lucide-icons/folder.svg
!web/public/vendor/lucide-icons/folder-open.svg
!web/public/vendor/lucide-icons/globe.svg
!web/public/vendor/lucide-icons/house.svg
!web/public/vendor/lucide-icons/list-tree.svg
!web/public/vendor/lucide-icons/loader-circle.svg
!web/public/vendor/lucide-icons/message-square.svg
!web/public/vendor/lucide-icons/notebook-tabs.svg
!web/public/vendor/lucide-icons/panel-left.svg
!web/public/vendor/lucide-icons/paperclip.svg
!web/public/vendor/lucide-icons/pause.svg
!web/public/vendor/lucide-icons/search.svg
!web/public/vendor/lucide-icons/send.svg
!web/public/vendor/lucide-icons/settings.svg
!web/public/vendor/lucide-icons/zap.svg

# 证书 / 密钥材料
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
